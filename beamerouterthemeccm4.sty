\mode<presentation>

\setbeamerfont{sectiontitle}{size=\huge, shape=\scshape}

%Barra de título
\defbeamertemplate*{frametitle}{CCM4}[1][]
{
  \begin{beamercolorbox}[wd=\the\paperwidth,ht=1.9cm]{frametitle}
    \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle(\the\paperwidth,1.4);
    
      \ifx\insertframesubtitle\@empty%
       {\node[anchor=west, rojotexto , font=\huge] at (0.85,0.82){\textbf{\insertframetitle}};}
       \else%
       {\node[anchor=west, rojotexto, font=\huge] at (0.85, 1.02){ \textbf{\insertframetitle}};%
       \node[anchor=west, rojotexto , font=\large] at (0.85, 0.53){\insertframesubtitle};}%
       \fi
     \end{tikzpicture}
   \end{beamercolorbox}
   \vskip-0.5cm
}

% --- 全新的、正确的底部导航栏定义 ---
\defbeamertemplate*{footline}{ccm4}
{
  \leavevmode%
  \hbox{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1ex,center]{author in head/foot}%
    \insertshortauthor \hfill \insertsectionnavigationhorizontal{0.6\paperwidth}{\hfill}{\hfill} \hfill \insertframenumber{} / \inserttotalframenumber
  \end{beamercolorbox}}%
  \vskip0pt%
}

\mode<all>